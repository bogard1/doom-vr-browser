diff --git c/src/autosegs.h i/src/autosegs.h
index 9cba04ad23..0c238879b7 100644
--- c/src/autosegs.h
+++ i/src/autosegs.h
@@ -49,6 +49,87 @@
 typedef void * const REGINFO;
 typedef void * NCREGINFO;
 
+#ifdef __EMSCRIPTEN__
+// wasm-ld does not lay out same-named `__attribute__((section(...)))`
+// globals contiguously across translation units the way ELF/COFF linkers
+// do -- verified empirically: CRegHead/CRegTail ended up 4 bytes apart at
+// runtime with zero class registrations found between them, so
+// PClass::StaticInit() found no built-in classes at all. Use an intrusive
+// linked list populated by ordinary global constructors instead; those are
+// guaranteed to run before main(), which is all StaticInit()-style
+// consumers need. See docs/questzdoom-architecture.md.
+struct RegListNode
+{
+	const void *data;
+	RegListNode *next;
+};
+struct RegListHead
+{
+	RegListNode *first = nullptr;
+};
+// A file-scope `static RegListPusher some_unique_name(SomeRegHead, data);`
+// pushes `data` onto `SomeRegHead`'s list when that translation unit's
+// static initializers run. `data` is `const void*` since several
+// registration entries (e.g. AFuncDesc) are `static const`.
+struct RegListPusher
+{
+	RegListNode node;
+	RegListPusher(RegListHead &head, const void *data)
+	{
+		node.data = data;
+		node.next = head.first;
+		head.first = &node;
+	}
+};
+
+// List of Action functons
+extern RegListHead ARegHead, ARegTail;
+
+// List of TypeInfos
+extern RegListHead CRegHead, CRegTail;
+
+// List of class fields
+extern RegListHead FRegHead, FRegTail;
+
+// List of properties
+extern RegListHead GRegHead, GRegTail;
+
+// List of MAPINFO map options
+extern RegListHead YRegHead, YRegTail;
+
+class FAutoSegIterator
+{
+	public:
+		// `tail` is unused (kept only so call sites match the non-Emscripten
+		// constructor signature below unchanged).
+		FAutoSegIterator(RegListHead &head, RegListHead & /*tail*/)
+			: HeadNode(head.first), Probe(nullptr), Started(false)
+		{
+		}
+		NCREGINFO operator*() const
+		{
+			return const_cast<NCREGINFO>(Started && Probe ? Probe->data : nullptr);
+		}
+		FAutoSegIterator &operator++()
+		{
+			Probe = Started ? (Probe ? Probe->next : nullptr) : HeadNode;
+			Started = true;
+			return *this;
+		}
+		void Reset()
+		{
+			Probe = nullptr;
+			Started = false;
+		}
+
+	protected:
+		RegListNode *HeadNode;
+		RegListNode *Probe;
+		bool Started;
+};
+
+#else
+
 // List of Action functons
 extern REGINFO ARegHead;
 extern REGINFO ARegTail;
@@ -111,3 +192,5 @@ class FAutoSegIterator
 };
 
 #endif
+
+#endif
