+	# lemon.c is 1990s K&R-style C (unmodified upstream SQLite lemon) and its
+	# loose function-pointer casts are hard errors under GCC >= 14's default
+	# C standard. This is a host-only build tool, not shipped code, so relax
+	# to the standard it was actually written against instead of patching it.
+	if( CMAKE_C_COMPILER_ID MATCHES "GNU|Clang" )
+		target_compile_options( lemon PRIVATE -std=gnu89 -Wno-implicit-function-declaration )
