+// One iteration of the loop below, factored out so it can also be used as
+// an emscripten_set_main_loop callback (see D_DoomLoop). Returns false if
+// the loop should stop (a restart was requested).
+static bool D_DoomLoopTic()
+{
+	try
+	{
+		I_SetFrameTime();
+
+		// process one or more tics
+		if (singletics)
+		{
+			//I_StartTic ();
+			D_ProcessEvents ();
+			G_BuildTiccmd (&netcmds[consoleplayer][maketic%BACKUPTICS]);
+			if (advancedemo)
+				D_DoAdvanceDemo ();
+			C_Ticker ();
+			M_Ticker ();
+			G_Ticker ();
+			// [RH] Use the consoleplayer's camera to update sounds
+			S_UpdateSounds (players[consoleplayer].camera);	// move positional sounds
+			gametic++;
+			maketic++;
+			GC::CheckGC ();
+			Net_NewMakeTic ();
+		}
+		else
+		{
+			TryRunTics (); // will run at least one tic
+		}
+		// Update display, next frame, with current state.
+		//I_StartTic ();
+		D_Display ();
+		S_UpdateMusic();
+		if (wantToRestart)
+		{
+			wantToRestart = false;
+			return false;
+		}
+	}
+	catch (CRecoverableError &error)
+	{
+		if (error.GetMessage ())
+		{
+			Printf (PRINT_BOLD, "\n%s\n", error.GetMessage());
+		}
+		D_ErrorCleanup ();
+	}
+	catch (CVMAbortException &error)
+	{
+		error.MaybePrintMessage();
+		Printf("%s", error.stacktrace.GetChars());
+		D_ErrorCleanup();
+	}
+	return true;
+}
+
+#ifdef __EMSCRIPTEN__
+// A real, natively-blocking `for (;;)` (the #else branch below) never
+// yields to the browser's event loop -- the tab just hangs. There's no
+// per-tic sleep/yield call to make Asyncify-based porting viable here
+// either (confirmed empirically: enabling -sASYNCIFY made the tab's
+// renderer process run out of memory and crash outright, presumably from
+// instrumenting this engine's entire, very large call graph). Driving tics
+// from a real emscripten_set_main_loop callback avoids that cost entirely.
+//
+// Known limitation: a CCMD-triggered restart (renderer switch, etc.) can't
+// resume the caller's do/while loop in D_DoomMain_Internal the way the
