+// Stand-in for QuestZDoom's Projects/Android/jni/QzDoom/VrInput.h -- see the
+// comment in the sibling VrCommon.h stub for why this exists. g_game.cpp is
+// the only engine file that includes <QzDoom/VrInput.h> directly, and it
+// only needs what VrCommon.h already provides (it declares its own extern
+// vec3_t hmdorientation / VR_GetMove() locally); the real header's
+// HandleInput_Default()/ovrInputStateTrackedRemote declarations are Oculus
+// SDK types this build has no use for.
+#if !defined(vrinput_h)
+#define vrinput_h
+
+#include "VrCommon.h"
+
+#endif //vrinput_h
diff --git c/platform/emscripten-stub/vr_stub.cpp i/platform/emscripten-stub/vr_stub.cpp
new file mode 100644
index 0000000000..5cdbe4efad
--- /dev/null
+++ i/platform/emscripten-stub/vr_stub.cpp
@@ -0,0 +1,71 @@
+// Definitions for the globals declared in QzDoom/VrCommon.h (see that
+// file's header comment). VR is not wired up yet for the Emscripten build
+// (docs/implementation-plan.md M1-M3 come before WebXR in M4+), so every
+// value here is an inert default: no VR is active, no movement/rotation is
+// injected, nothing is ever true.
+#include <cstdint>
+#include "QzDoom/VrCommon.h"
+
+bool qzdoom_initialised = false;
+
+bool cinemamode = false;
+float cinemamodeYaw = 0;
+float cinemamodePitch = 0;
+
+float playerYaw = 0;
+bool resetDoomYaw = false;
+float doomYaw = 0;
+bool resetPreviousPitch = false;
+float previousPitch = 0;
+
+float vrFOV = 90;
+
+vec3_t worldPosition = { 0, 0, 0 };
+
+vec3_t hmdPosition = { 0, 0, 0 };
+vec3_t hmdorientation = { 0, 0, 0 };
+vec3_t positionDeltaThisFrame = { 0, 0, 0 };
+
+vec3_t weaponangles = { 0, 0, 0 };
+vec3_t weaponoffset = { 0, 0, 0 };
+
+vec3_t offhandangles = { 0, 0, 0 };
+vec3_t offhandoffset = { 0, 0, 0 };
+
+bool player_moving = false;
+
+bool ready_teleport = false;
+bool trigger_teleport = false;
+
+// Declared extern by g_game.cpp/doomstat.h directly (not via VrCommon.h).
+float snapTurn = 0;
+bool weaponStabilised = false;
+
+void shutdownVR() {}
+
+float QzDoom_GetFOV() { return 90.f; }
+void QzDoom_GetScreenRes(uint32_t *width, uint32_t *height) {}
+void QzDoom_Vibrate(float duration, int channel, float intensity) {}
+void VR_HapticEvent(const char *event, int position, int intensity, float angle, float yHeight) {}
+
+bool isMultiplayer() { return false; }
+float nonLinearFilter(float in) { return in; }
+void rotateAboutOrigin(float v1, float v2, float rotation, vec2_t out) { out[0] = v1; out[1] = v2; }
+
+void QzDoom_setUseScreenLayer(bool use) {}
+void jni_shutdown() {}
+
+// g_game.cpp declares this itself (extern) and calls it every tic; with no
+// VR input source yet, report no movement.
+void VR_GetMove(float *joy_forward, float *joy_side, float *hmd_forward, float *hmd_side,
+	float *up, float *yaw, float *pitch, float *roll)
+{
+	*joy_forward = 0;
+	*joy_side = 0;
+	*hmd_forward = 0;
+	*hmd_side = 0;
+	*up = 0;
+	*yaw = 0;
+	*pitch = 0;
+	*roll = 0;
+}
