+// Definitions for QuestZDoom globals that WebXR does not use directly. The
+// browser bridge supplies thumbstick locomotion through VR_GetMove();
+// controller poses and room-scale movement remain later milestones.
+#include <cstdint>
+#include "QzDoom/VrCommon.h"
+#include "../web/vr_webxr.h"
+#include "g_game.h"
+
+bool qzdoom_initialised = false;
+
+bool cinemamode = false;
+float cinemamodeYaw = 0;
+float cinemamodePitch = 0;
+
+float playerYaw = 0;
+bool resetDoomYaw = false;
+float doomYaw = 0;
+bool resetPreviousPitch = false;
+float previousPitch = 0;
+
+float vrFOV = 90;
+
+vec3_t worldPosition = { 0, 0, 0 };
+
+vec3_t hmdPosition = { 0, 0, 0 };
+vec3_t hmdorientation = { 0, 0, 0 };
+vec3_t positionDeltaThisFrame = { 0, 0, 0 };
+
+vec3_t weaponangles = { 0, 0, 0 };
+vec3_t weaponoffset = { 0, 0, 0 };
+
+vec3_t offhandangles = { 0, 0, 0 };
+vec3_t offhandoffset = { 0, 0, 0 };
+
+bool player_moving = false;
+
+bool ready_teleport = false;
+bool trigger_teleport = false;
+
+// Declared extern by g_game.cpp/doomstat.h directly (not via VrCommon.h).
+float snapTurn = 0;
+bool weaponStabilised = false;
+
+void shutdownVR() {}
+
+float QzDoom_GetFOV() { return 90.f; }
+void QzDoom_GetScreenRes(uint32_t *width, uint32_t *height) {}
+void QzDoom_Vibrate(float duration, int channel, float intensity) {}
+void VR_HapticEvent(const char *event, int position, int intensity, float angle, float yHeight) {}
+
+bool isMultiplayer() { return false; }
+float nonLinearFilter(float in) { return in; }
+void rotateAboutOrigin(float v1, float v2, float rotation, vec2_t out) { out[0] = v1; out[1] = v2; }
+
+void QzDoom_setUseScreenLayer(bool use) {}
+void jni_shutdown() {}
+
+// g_game.cpp calls this every tic. WebXR updates analog state once per XR
+// frame; positional room-scale movement and orientation outputs remain zero.
+void VR_GetMove(float *joy_forward, float *joy_side, float *hmd_forward, float *hmd_side,
+	float *up, float *yaw, float *pitch, float *roll)
+{
+	WebXR_GetLocomotion(joy_forward, joy_side);
+	G_AddViewPitch(WebXR_GetLookPitch());
+	*hmd_forward = 0;
+	*hmd_side = 0;
+	*up = 0;
+	*yaw = 0;
+	*pitch = 0;
+	*roll = 0;
+}
diff --git c/platform/web/vr_webxr.cpp i/platform/web/vr_webxr.cpp
new file mode 100644
index 0000000000..a621bbeeaa
--- /dev/null
+++ i/platform/web/vr_webxr.cpp
@@ -0,0 +1,609 @@
+// WebXR head-tracking bridge (M5). web/src/xr.ts calls VR_WebXR_SetActive on
+// XR session start/end and VR_WebXR_SetHeadPose once per XR frame; this file
+// converts the raw pose into engine camera angles.
+//
+// Body/head separation (docs/questzdoom-architecture.md §5, mirroring
+// QuestZDoom's doomYaw/hmdorientation split): the values computed here are
+// applied only to r_viewpoint.Angles/Pos, which R_SetupFrame() has already
+// derived from the player actor's real body Angles by the time
+// Stereo3DMode::SetUp() runs (see gl_scene.cpp's RenderViewpoint -- SetUp()
+// is called after R_SetupFrame, not before). Nothing here ever touches the
+// player actor itself, so turning your head changes the rendered view
+// direction without changing movement direction by construction, rather
+// than needing extra bookkeeping to keep the two in sync.
+#include "vr_webxr.h"
+
+#include <cmath>
+#include <emscripten.h>
+#include "r_utility.h"
+#include "c_cvars.h"
+#include "c_dispatch.h"
+#include "d_event.h"
+#include "d_player.h"
+#include "doomdef.h"
+#include "g_game.h"
+#include "g_levellocals.h"
+#include "gl/renderer/gl_renderer.h"
+#include "gl/renderer/gl_renderbuffers.h"
+
+CVAR(Bool, vr_webxr_use_position, true, CVAR_ARCHIVE | CVAR_GLOBALCONFIG)
+CVAR(Bool, vr_webxr_controller_weapon, false, CVAR_ARCHIVE | CVAR_GLOBALCONFIG)
+EXTERN_CVAR(Float, vr_vunits_per_meter)
+EXTERN_CVAR(Float, vr_weaponScale)
+EXTERN_CVAR(Bool, vr_move_use_offhand)
+EXTERN_CVAR(Bool, vr_switch_sticks)
+EXTERN_CVAR(Float, vr_snapTurn)
+
+namespace {
+
+// XRWebGLLayer.framebuffer is a JavaScript object. The browser stores it on
+// Module before calling the C ABI; this bridge gives it an Emscripten GL name
+// so ordinary glBindFramebuffer calls can target it. It must never be deleted
+// by C++ because XRWebGLLayer owns the underlying object.
+EM_JS(int, WebXR_RegisterLayerFramebuffer, (), {
+  const framebuffer = Module['webxrLayerFramebuffer'];
+  if (!framebuffer) return 0;
+  let handle = Module['webxrLayerFramebufferHandle'];
+  if (!handle) {
+    handle = GL.getNewId(GL.framebuffers);
+    Module['webxrLayerFramebufferHandle'] = handle;
+  }
+  GL.framebuffers[handle] = framebuffer;
+  return handle;
+});
+
+EM_JS(void, WebXR_ReleaseLayerFramebuffer, (), {
+  const handle = Module['webxrLayerFramebufferHandle'];
+  if (handle) GL.framebuffers[handle] = null;
+  Module['webxrLayerFramebuffer'] = null;
+  Module['webxrLayerFramebufferHandle'] = 0;
+});
+
+bool g_active = false;
+bool g_haveYawZero = false;
+double g_yawZeroDeg = 0.0;
+bool g_haveHeightZero = false;
+double g_heightZeroMeters = 0.0;
+
+double g_yawDeg = 0.0;
+double g_pitchDeg = 0.0;
+double g_rollDeg = 0.0;
+double g_heightMeters = 0.0;
+double g_headPosition[3] = { 0.0, 0.0, 0.0 };
+float g_locomotionForward = 0.0f;
+float g_locomotionSide = 0.0f;
+float g_lookPitch = 0.0f;
+int g_snapTurnLatch = 0;
+
+struct WebXRControllerState
+{
+	bool valid = false;
+	float position[3] = { 0.0f, 0.0f, 0.0f };
+	float yawRelativeDeg = 0.0f;
+	float yawDeg = 0.0f;
+	float pitchDeg = 0.0f;
+	float rollDeg = 0.0f;
+};
+
+WebXRControllerState g_rightController;
+
+struct WebXREyeState
+{
+	s3d::Viewport viewport = { 0, 0, 0, 0 };
+	float offset[3] = { 0.0f, 0.0f, 0.0f };
+	float projection[16] = {};
+	bool hasViewport = false;
+	bool hasOffset = false;
+	bool hasProjection = false;
+};
+
+GLuint g_xrFramebuffer = 0;
+WebXREyeState g_eyes[2];
+
+bool IsEyeIndexValid(int eye)
+{
+	return eye >= 0 && eye < 2;
+}
+
+bool IsEyeValid(int eye)
+{
+	const WebXREyeState& state = g_eyes[eye];
+	return state.hasViewport && state.hasOffset && state.hasProjection &&
+		state.viewport.width > 0 && state.viewport.height > 0;
+}
+
+float ApplyStickDeadzone(float value, float other, float &outOther)
+{
+	const float length = std::sqrt(value * value + other * other);
+	if (length <= 0.20f)
+	{
+		outOther = 0.0f;
+		return 0.0f;
+	}
+	const float scale = std::min(1.0f, (length - 0.20f) / 0.80f) / length;
+	outOther = other * scale;
+	return value * scale;
+}
+
+int AngleFromDegrees(float degrees)
+{
+	return static_cast<int>(std::round(65535.0f * degrees / 360.0f));
+}
+
+DVector3 ControllerDirection()
+{
+	const DAngle yaw(g_rightController.yawDeg - 90.0f);
+	const DAngle pitch(-g_rightController.pitchDeg);
+	const double cosPitch = pitch.Cos();
+	return { cosPitch * yaw.Cos(), cosPitch * yaw.Sin(), -pitch.Sin() };
+}
+
+DVector3 WebXRMapAttackDir(AActor *, DAngle, DAngle)
+{
+	return ControllerDirection();
+}
+
+} // namespace
+
+bool WebXR_IsActive()
+{
+	return g_active;
+}
+
+bool WebXR_IsStereoReady()
+{
+	return g_active && g_xrFramebuffer != 0 && IsEyeValid(0) && IsEyeValid(1);
+}
+
+extern "C" {
+
+void VR_WebXR_SetActive(int active)
+{
+	g_active = active != 0;
+	g_haveYawZero = false;
+	if (!g_active)
+	{
+		player_t *player = r_viewpoint.camera ? r_viewpoint.camera->player : nullptr;
+		if (player) player->mo->OverrideAttackPosDir = false;
+		g_yawDeg = g_pitchDeg = g_rollDeg = g_heightMeters = 0.0;
+		g_headPosition[0] = g_headPosition[1] = g_headPosition[2] = 0.0;
+		g_rightController = WebXRControllerState();
+		g_haveHeightZero = false;
+		g_locomotionForward = g_locomotionSide = g_lookPitch = 0.0f;
+		g_snapTurnLatch = 0;
+		g_xrFramebuffer = 0;
+		WebXR_ReleaseLayerFramebuffer();
+		g_eyes[0] = WebXREyeState();
+		g_eyes[1] = WebXREyeState();
+	}
+
+	// XRWebGLLayer's framebuffer is valid only during the runtime's frame
+	// callback. d_main.cpp pauses its own browser callback while this is true;
+	// web/src/xr.ts then drives one engine frame from each XR rAF.
+	WebXR_SetFrameOwnership(g_active);
+}
+
+// qx/qy/qz/qw: WebXR head orientation (XRRigidTransform.orientation) -- a
+// right-handed, Y-up, -Z-forward quaternion relative to the session's
+// 'local-floor' (or 'local') reference space, as sampled by
+// XRFrame.getViewerPose() in web/src/xr.ts.
+// px/py/pz: the same transform's position, in meters, same reference space.
+void VR_WebXR_SetHeadPose(float qx, float qy, float qz, float qw,
+                           float px, float py, float pz)
+{
+	// YXZ Tait-Bryan extraction (yaw about Y, then pitch about X, then roll
+	// about Z) -- the standard decomposition for FPS/HMD-style cameras in a
+	// Y-up right-handed space, chosen because it stays gimbal-free across
+	// the yaw/pitch ranges a human neck actually produces (the same reason
+	// e.g. three.js's PointerLockControls uses 'YXZ' Euler order for camera
+	// look). Formulas derived from the standard quaternion-to-rotation-matrix
+	// expansion, not copied from a reference implementation.
+	const double x = qx, y = qy, z = qz, w = qw;
+
+	const double m20 = 2.0 * (x * z - w * y);
+	const double m22 = 1.0 - 2.0 * (x * x + y * y);
+	const double yawRaw = std::atan2(m20, m22);
+
+	double sinPitch = 2.0 * (y * z + w * x);
+	if (sinPitch > 1.0) sinPitch = 1.0;
+	if (sinPitch < -1.0) sinPitch = -1.0;
+	const double pitchRaw = std::asin(-sinPitch);
+
+	const double m01 = 2.0 * (x * y - w * z);
+	const double m11 = 1.0 - 2.0 * (x * x + z * z);
+	const double rollRaw = std::atan2(m01, m11);
+
+	const double RAD2DEGD = 180.0 / M_PI;
+
+	// Sign check against src/d_main.cpp's mouse-look handling: a positive
+	// mouse-X (turning the view right) sends a positive turn that
+	// *decreases* Angles.Yaw, and a positive mouse-Y (looking down) sends a
+	// positive look that *increases* LocalViewPitch. Working through the
+	// same rotation-direction analysis for this quaternion extraction: yaw
+	// and roll come out CCW-positive in WebXR's space but need negating to
+	// match Angles' convention; pitch already comes out positive-is-down,
+	// matching Angles directly, so it is not negated. Roll is the least
+	// certain of the three -- Doom has no native roll input to cross-check
+	// against, so if it looks inverted on real hardware, flip the sign here.
+	double yawDeg = -(yawRaw * RAD2DEGD);
+	const double pitchDeg = pitchRaw * RAD2DEGD;
+	const double rollDeg = -(rollRaw * RAD2DEGD);
+
+	if (!g_haveYawZero)
+	{
+		// Recenter: whichever way the player was physically facing when
+		// tracking started becomes "look straight ahead" relative to the
+		// body's existing (keyboard/mouse-controlled) facing direction.
+		// Only yaw is recentered like this -- pitch/roll are used as-is,
+		// since "which way is down" is defined by gravity, not by where the
+		// player happened to be facing.
+		g_yawZeroDeg = yawDeg;
+		g_haveYawZero = true;
+	}
+	yawDeg -= g_yawZeroDeg;
+
+	g_yawDeg = yawDeg;
+	g_pitchDeg = pitchDeg;
+	g_rollDeg = rollDeg;
+	g_headPosition[0] = px;
+	g_headPosition[1] = py;
+	g_headPosition[2] = pz;
+	// Doom already puts the view at the player's standing eye height. Use the
+	// first local-floor sample as zero so a typical 1.6 m WebXR floor height is
+	// not added a second time; subsequent stand/crouch motion remains visible.
+	if (!g_haveHeightZero)
+	{
+		g_heightZeroMeters = py;
+		g_haveHeightZero = true;
+	}
+	g_heightMeters = py - g_heightZeroMeters;
+}
+
+void VR_WebXR_RegisterFramebuffer(int framebuffer)
+{
+	(void)framebuffer;
+	g_xrFramebuffer = static_cast<GLuint>(WebXR_RegisterLayerFramebuffer());
+}
+
+void VR_WebXR_InvalidateFramebuffer()
+{
+	g_xrFramebuffer = 0;
+	WebXR_ReleaseLayerFramebuffer();
+}
+
+void VR_WebXR_SetEyeViewport(int eye, int x, int y, int width, int height)
+{
+	if (!IsEyeIndexValid(eye)) return;
+
+	WebXREyeState& state = g_eyes[eye];
+	state.viewport = { x, y, width, height };
+	state.hasViewport = width > 0 && height > 0;
+}
+
+void VR_WebXR_SetEyeOffset(int eye, float x, float y, float z)
+{
+	if (!IsEyeIndexValid(eye) || !std::isfinite(x) || !std::isfinite(y) || !std::isfinite(z)) return;
+
+	WebXREyeState& state = g_eyes[eye];
+	state.offset[0] = x;
+	state.offset[1] = y;
+	state.offset[2] = z;
+	state.hasOffset = true;
+}
+
+void VR_WebXR_SetEyeProjection(int eye,
+	float m00, float m01, float m02, float m03,
+	float m04, float m05, float m06, float m07,
+	float m08, float m09, float m10, float m11,
+	float m12, float m13, float m14, float m15)
+{
+	if (!IsEyeIndexValid(eye)) return;
+
+	const float projection[16] = {
+		m00, m01, m02, m03, m04, m05, m06, m07,
+		m08, m09, m10, m11, m12, m13, m14, m15
+	};
+	for (int i = 0; i < 16; ++i)
+	{
+		if (!std::isfinite(projection[i])) return;
+	}
+
+	WebXREyeState& state = g_eyes[eye];
+	for (int i = 0; i < 16; ++i)
+	{
+		state.projection[i] = projection[i];
+	}
+	state.hasProjection = true;
+}
+
+void VR_WebXR_PostKeyEvent(int key, int down)
+{
+	if (key <= 0 || key >= NUM_KEYS) return;
+
+	event_t event = {};
+	event.type = down ? EV_KeyDown : EV_KeyUp;
+	event.data1 = static_cast<int16_t>(key);
+	D_PostEvent(&event);
+}
+
+void VR_WebXR_SetLocomotion(int validMask,
+	float leftX, float leftY, float rightX, float rightY,
+	float leftYawDeg, float rightYawDeg)
+{
+	if (!g_active) return;
+	const bool useRightStick = vr_switch_sticks;
+	const bool hasMoveStick = validMask & (useRightStick ? 2 : 1);
+	const float moveX = useRightStick ? rightX : leftX;
+	const float moveY = useRightStick ? rightY : leftY;
+	const bool hasMoveYaw = validMask & (useRightStick ? 8 : 4);
+	const float moveYaw = useRightStick ? rightYawDeg : leftYawDeg;
+
+	if (!hasMoveStick || !std::isfinite(moveX) || !std::isfinite(moveY))
+	{
+		g_locomotionForward = g_locomotionSide = 0.0f;
+	}
+	else
+	{
+		float side = std::max(-1.0f, std::min(1.0f, moveX));
+		float forward = std::max(-1.0f, std::min(1.0f, -moveY));
+		forward = ApplyStickDeadzone(forward, side, side);
+
+		float heading = static_cast<float>(g_yawDeg);
+		if (vr_move_use_offhand && hasMoveYaw && g_haveYawZero && std::isfinite(moveYaw))
+		{
+			heading = moveYaw - static_cast<float>(g_yawZeroDeg);
+		}
+		const float radians = DEG2RAD(heading);
+		g_locomotionForward = forward * std::cos(radians) + side * std::sin(radians);
+		g_locomotionSide = -forward * std::sin(radians) + side * std::cos(radians);
+	}
+
+	const float snapX = useRightStick ? leftX : rightX;
+	const float lookY = useRightStick ? leftY : rightY;
+	const bool hasSnapStick = validMask & (useRightStick ? 1 : 2);
+	if (!hasSnapStick || !std::isfinite(lookY) || std::abs(lookY) <= 0.20f)
+	{
+		g_lookPitch = 0.0f;
+	}
+	else
+	{
+		const float magnitude = (std::abs(lookY) - 0.20f) / 0.80f;
+		g_lookPitch = -std::copysign(std::min(1.0f, magnitude), lookY);
+	}
+	if (!hasSnapStick || !std::isfinite(snapX) || std::abs(snapX) < 0.45f)
+	{
+		g_snapTurnLatch = 0;
+	}
+	else if (g_snapTurnLatch == 0 && std::abs(snapX) >= 0.60f)
+	{
+		g_snapTurnLatch = snapX > 0.0f ? 1 : -1;
+		G_AddViewAngle(g_snapTurnLatch * AngleFromDegrees(vr_snapTurn));
+	}
+}
+
+void VR_WebXR_SetRightControllerPose(int valid,
+	float qx, float qy, float qz, float qw,
+	float px, float py, float pz)
+{
+	g_rightController.valid = false;
+	if (!g_active || valid == 0 || !g_haveYawZero ||
+		!std::isfinite(qx) || !std::isfinite(qy) || !std::isfinite(qz) || !std::isfinite(qw) ||
+		!std::isfinite(px) || !std::isfinite(py) || !std::isfinite(pz)) return;
+
+	const double x = qx, y = qy, z = qz, w = qw;
+	const double m20 = 2.0 * (x * z - w * y);
+	const double m22 = 1.0 - 2.0 * (x * x + y * y);
+	const double yawRaw = std::atan2(m20, m22);
+	const double sinPitch = std::max(-1.0, std::min(1.0, 2.0 * (y * z + w * x)));
+	const double pitchRaw = std::asin(-sinPitch);
+	const double m01 = 2.0 * (x * y - w * z);
+	const double m11 = 1.0 - 2.0 * (x * x + z * z);
+	const double rollRaw = std::atan2(m01, m11);
+	const double radiansToDegrees = 180.0 / M_PI;
+
+	// Align this reference-space orientation with the same body-forward zero
+	// used by the headset. It keeps weapon aim independent of head yaw.
+	g_rightController.yawRelativeDeg = -static_cast<float>(yawRaw * radiansToDegrees) - static_cast<float>(g_yawZeroDeg);
+	g_rightController.pitchDeg = static_cast<float>(pitchRaw * radiansToDegrees);
+	g_rightController.rollDeg = -static_cast<float>(rollRaw * radiansToDegrees);
+	g_rightController.position[0] = px;
+	g_rightController.position[1] = py;
+	g_rightController.position[2] = pz;
+	g_rightController.valid = true;
+}
+
+void VR_WebXR_Recenter()
+{
+	g_haveYawZero = false;
+}
+
+} // extern "C"
+
+void WebXR_GetLocomotion(float *forward, float *side)
+{
+	*forward = g_locomotionForward;
+	*side = g_locomotionSide;
+}
+
+int WebXR_GetLookPitch()
+{
+	// 90 degrees/sec at full deflection, consumed at Doom's fixed 35 Hz tic.
+	return AngleFromDegrees(g_lookPitch * 90.0f / TICRATE);
+}
+
+CCMD(vr_recenter)
+{
+	VR_WebXR_Recenter();
+}
+
+namespace s3d {
+
+WebXRDeviceEyePose::WebXRDeviceEyePose(int eye)
+	: eye(eye)
+{
+}
+
+VSMatrix WebXRDeviceEyePose::GetProjection(float fov, float aspectRatio, float fovRatio) const
+{
+	VSMatrix projection;
+	projection.loadMatrix(g_eyes[eye].projection);
+	return projection;
+}
+
+void WebXRDeviceEyePose::GetViewShift(float yaw, float outViewShift[3]) const
+{
+	const WebXREyeState& state = g_eyes[eye];
+	const float yawRadians = DEG2RAD(yaw);
+	const float scale = vr_vunits_per_meter;
+	const float cosYaw = std::cos(yawRadians);
+	const float sinYaw = std::sin(yawRadians);
+
+	// WebXR is right-handed with -Z forward. Rotate its viewer-relative
+	// offset into Doom's horizontal yaw plane, then scale meters to map units.
+	outViewShift[0] = (-cosYaw * state.offset[0] - sinYaw * state.offset[2]) * scale;
+	outViewShift[1] = (sinYaw * state.offset[0] - cosYaw * state.offset[2]) * scale;
+	outViewShift[2] = state.offset[1] * scale;
+}
+
+WebXRDeviceMode::WebXRDeviceMode()
+	: leftEye(0), rightEye(1)
+{
+	eye_ptrs.Push(&centralEye);
+}
+
+const Stereo3DMode& WebXRDeviceMode::getInstance()
+{
+	static WebXRDeviceMode instance;
+	return instance;
+}
+
+int WebXRDeviceMode::eye_count() const
+{
+	return WebXR_IsStereoReady() ? 2 : 1;
+}
+
+const EyePose *WebXRDeviceMode::getEyePose(int ix) const
+{
+	if (!WebXR_IsStereoReady()) return &centralEye;
+	return ix == 0 ? &leftEye : &rightEye;
+}
+
+bool WebXRDeviceMode::IsMono() const
+{
+	return !WebXR_IsStereoReady();
+}
+
+void WebXRDeviceMode::SetUp() const
+{
+	Stereo3DMode::SetUp();
+
+	r_viewpoint.Angles.Yaw = (r_viewpoint.Angles.Yaw + DAngle(g_yawDeg)).Normalized180();
+	r_viewpoint.Angles.Pitch = (r_viewpoint.Angles.Pitch + DAngle(g_pitchDeg)).Normalized180();
+	r_viewpoint.Angles.Roll = (r_viewpoint.Angles.Roll + DAngle(g_rollDeg)).Normalized180();
+
+	if (vr_webxr_use_position)
+	{
+		r_viewpoint.Pos.Z += g_heightMeters * vr_vunits_per_meter;
+	}
+
+	player_t *player = r_viewpoint.camera ? r_viewpoint.camera->player : nullptr;
+	if (!player) return;
+	const bool useControllerWeapon = vr_webxr_controller_weapon && g_rightController.valid;
+	player->mo->OverrideAttackPosDir = useControllerWeapon;
+	if (!useControllerWeapon) return;
+
+	const float bodyYaw = static_cast<float>(r_viewpoint.Angles.Yaw.Degrees - g_yawDeg);
+	g_rightController.yawDeg = bodyYaw + g_rightController.yawRelativeDeg;
+	const float controllerX = static_cast<float>(g_rightController.position[0] - g_headPosition[0]);
+	const float controllerY = static_cast<float>(g_rightController.position[1] - g_headPosition[1]);
+	const float controllerZ = static_cast<float>(g_rightController.position[2] - g_headPosition[2]);
+	const double pixelstretch = level.info ? level.info->pixelstretch : 1.2;
+	const float scale = vr_vunits_per_meter;
+
+	player->mo->AttackAngle = g_rightController.yawDeg - 90.0f;
+	player->mo->AttackPitch = -g_rightController.pitchDeg;
+	player->mo->AttackRoll = g_rightController.rollDeg;
+	player->mo->AttackPos.X = player->mo->X() - controllerX * scale;
+	player->mo->AttackPos.Y = player->mo->Y() - controllerZ * scale;
+	player->mo->AttackPos.Z = r_viewpoint.CenterEyePos.Z +
+		((g_headPosition[1] + controllerY) * scale / pixelstretch) - player->DefaultViewHeight();
+	player->mo->AttackDir = WebXRMapAttackDir;
+}
+
+void WebXRDeviceMode::AdjustPlayerSprites(int hand) const
+{
+	if (GetWeaponTransform(&gl_RenderState.mModelMatrix, hand))
+	{
+		const float scale = 0.000625f * vr_weaponScale;
+		gl_RenderState.mModelMatrix.scale(scale, -scale, scale);
+		gl_RenderState.mModelMatrix.translate(-viewwidth / 2, -viewheight * 3 / 4, 0.0f);
+		gl_RenderState.EnableModelMatrix(true);
+		return;
+	}
+
+	// Player sprites normally use pixel coordinates after Begin2D(), making
+	// the weapon a different screen-space image in each eye. Place that quad
+	// once in world space instead, so the existing eye view matrices create
+	// the correct disparity. This remains the fallback while the right grip is
+	// unavailable, so a disconnected controller never hides the weapon.
+	const float unitsPerMeter = vr_vunits_per_meter;
+	const float weaponDistance = 0.55f * unitsPerMeter;
+	const float weaponDrop = 0.20f * unitsPerMeter;
+	const DVector2 forward = r_viewpoint.Angles.Yaw.ToVector();
+
+	gl_RenderState.mModelMatrix.loadIdentity();
+	gl_RenderState.mModelMatrix.translate(
+		r_viewpoint.CenterEyePos.X + forward.X * weaponDistance,
+		r_viewpoint.CenterEyePos.Z - weaponDrop,
+		r_viewpoint.CenterEyePos.Y + forward.Y * weaponDistance);
+	gl_RenderState.mModelMatrix.rotate(-90.0f + r_viewpoint.Angles.Yaw.Degrees, 0.0f, 1.0f, 0.0f);
+	gl_RenderState.mModelMatrix.rotate(-r_viewpoint.Angles.Pitch.Degrees, 1.0f, 0.0f, 0.0f);
+
+	const float scale = 0.000625f * vr_weaponScale * unitsPerMeter;
+	gl_RenderState.mModelMatrix.scale(scale, -scale, scale);
+	gl_RenderState.mModelMatrix.translate(-viewwidth / 2, -viewheight * 3 / 4, 0.0f);
+	gl_RenderState.EnableModelMatrix(true);
+}
+
+bool WebXRDeviceMode::GetWeaponTransform(VSMatrix *out, int hand) const
+{
+	player_t *player = r_viewpoint.camera ? r_viewpoint.camera->player : nullptr;
+	if (hand != 0 || !vr_webxr_controller_weapon || !g_rightController.valid || !player) return false;
+
+	const float controllerX = static_cast<float>(g_rightController.position[0] - g_headPosition[0]);
+	const float controllerY = static_cast<float>(g_rightController.position[1] - g_headPosition[1]);
+	const float controllerZ = static_cast<float>(g_rightController.position[2] - g_headPosition[2]);
+	const double pixelstretch = level.info ? level.info->pixelstretch : 1.2;
+
+	out->loadIdentity();
+	out->translate(r_viewpoint.CenterEyePos.X, r_viewpoint.CenterEyePos.Z - player->DefaultViewHeight(), r_viewpoint.CenterEyePos.Y);
+	out->scale(vr_vunits_per_meter, vr_vunits_per_meter, -vr_vunits_per_meter);
+	out->translate(-controllerX, static_cast<float>((g_headPosition[1] + controllerY) / pixelstretch), controllerZ);
+	out->scale(1.0f, static_cast<float>(1.0 / pixelstretch), 1.0f);
+	out->rotate(-90.0f + g_rightController.yawDeg, 0.0f, 1.0f, 0.0f);
+	out->rotate(-g_rightController.pitchDeg, 1.0f, 0.0f, 0.0f);
+	out->rotate(-g_rightController.rollDeg, 0.0f, 0.0f, 1.0f);
+	return true;
+}
+
+void WebXRDeviceMode::UnAdjustPlayerSprites() const
+{
+	gl_RenderState.EnableModelMatrix(false);
+}
+
+void WebXRDeviceMode::Present() const
+{
+	if (!WebXR_IsStereoReady()) return;
+
+	glBindFramebuffer(GL_FRAMEBUFFER, g_xrFramebuffer);
+	for (int eye = 0; eye < 2; ++eye)
+	{
+		const Viewport& viewport = g_eyes[eye].viewport;
+		const GL_IRECT box = { viewport.x, viewport.y, viewport.width, viewport.height };
+		glScissor(box.left, box.top, box.width, box.height);
+		GLRenderer->mBuffers->BindEyeTexture(eye, 0);
+		GLRenderer->DrawPresentTexture(box, true);
+	}
+}
+
+} // namespace s3d
