+// Stand-in for QuestZDoom's Projects/Android/jni/QzDoom/VrInput.h -- see the
+// comment in the sibling VrCommon.h stub for why this exists. g_game.cpp is
+// the only engine file that includes <QzDoom/VrInput.h> directly, and it
+// only needs what VrCommon.h already provides (it declares its own extern
+// vec3_t hmdorientation / VR_GetMove() locally); the real header's
+// HandleInput_Default()/ovrInputStateTrackedRemote declarations are Oculus
+// SDK types this build has no use for.
+#if !defined(vrinput_h)
+#define vrinput_h
+
+#include "VrCommon.h"
+
+#endif //vrinput_h
