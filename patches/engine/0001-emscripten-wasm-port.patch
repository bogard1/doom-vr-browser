+	// fall back to; MonoView is the normal non-VR desktop/web rendering
+	// path (see getMonoMode() below) and is what WebXR M4+ will eventually
+	// replace with its own Stereo3DMode.
+#ifdef __ANDROID__
 	setCurrentMode(OpenXRDeviceMode::getInstance());
+#else
+	setCurrentMode(MonoView::getInstance());
+#endif
 	return *currentStereo3DMode;
 }
 
