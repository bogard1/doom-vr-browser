diff --git c/src/gl/system/gl_load.c i/src/gl/system/gl_load.c
index cbdef1f56f..daec8af554 100644
--- c/src/gl/system/gl_load.c
+++ i/src/gl/system/gl_load.c
@@ -108,7 +108,32 @@ static void *MOBILE_GetProcAddress(const char* name)
 
 #endif
 
+#if defined(__EMSCRIPTEN__)
+/* WebGL2/GLES3 has no equivalent of these desktop-GL4-era extensions
+ * (ARB_buffer_storage, ARB_shader_storage_buffer_object, etc. -- see
+ * docs/questzdoom-architecture.md); report every one of them as absent
+ * exactly like a real GL implementation lacking the extension would,
+ * rather than pulling in an EGL/GLX-style loader that has nothing to load. */
+static void *Emscripten_GetProcAddress(const char *name)
+{
+	(void)name;
+	return NULL;
+}
+#endif
+
+/* This was unconditionally pinned to MOBILE_GetProcAddress regardless of
+ * platform, even though AppleGLGetProcAddress/PosixGetProcAddress above are
+ * only ever defined, never called -- i.e. this file's non-mobile GL
+ * extension loading was already broken before the Emscripten port. */
+#if defined(__APPLE__)
+#define IntGetProcAddress(name) AppleGLGetProcAddress((const char*)name)
+#elif defined(__EMSCRIPTEN__)
+#define IntGetProcAddress(name) Emscripten_GetProcAddress((const char*)name)
+#elif defined(__MOBILE__)
 #define IntGetProcAddress(name) MOBILE_GetProcAddress((const char*)name)
+#elif defined(__sgi) || defined (__sun) || defined(__unix__)
+#define IntGetProcAddress(name) PosixGetProcAddress((const GLubyte*)name)
+#endif
 
 int ogl_ext_ARB_buffer_storage = ogl_LOAD_FAILED;
 int ogl_ext_ARB_shader_storage_buffer_object = ogl_LOAD_FAILED;
