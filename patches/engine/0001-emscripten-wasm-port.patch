+// WebXR head-tracking and stereo bridge. The browser passes only primitive
+// values through this C ABI; this code never needs WebXR JS types or the JS
+// heap.
+#ifndef VR_WEBXR_H
+#define VR_WEBXR_H
+
+#include "gl/stereo3d/gl_stereo3d.h"
+
+// True once the browser has told the engine a WebXR session is active (see
+// VR_WebXR_SetActive in vr_webxr.cpp).
+bool WebXR_IsActive();
+bool WebXR_IsStereoReady();
+void WebXR_SetFrameOwnership(bool active);
+void WebXR_GetLocomotion(float *forward, float *side);
+int WebXR_GetLookPitch();
+
+extern "C" {
+
+// framebuffer is an Emscripten WebGL framebuffer handle, not a WebXR JS
+// object. A non-positive value invalidates the current XR target.
+void VR_WebXR_RegisterFramebuffer(int framebuffer);
+void VR_WebXR_InvalidateFramebuffer();
+void VR_WebXR_SetEyeViewport(int eye, int x, int y, int width, int height);
+void VR_WebXR_SetEyeOffset(int eye, float x, float y, float z);
+void VR_WebXR_SetEyeProjection(int eye,
+	float m00, float m01, float m02, float m03,
+	float m04, float m05, float m06, float m07,
+	float m08, float m09, float m10, float m11,
+	float m12, float m13, float m14, float m15);
+void VR_WebXR_PostKeyEvent(int key, int down);
+void VR_WebXR_SetLocomotion(int validMask,
+	float leftX, float leftY, float rightX, float rightY,
+	float leftYawDeg, float rightYawDeg);
+void VR_WebXR_SetRightControllerPose(int valid,
+	float qx, float qy, float qz, float qw,
+	float px, float py, float pz);
+int VR_WebXR_RunFrame();
+
+} // extern "C"
+
+namespace s3d {
+
+class WebXRDeviceEyePose : public EyePose
+{
+public:
+	explicit WebXRDeviceEyePose(int eye);
+
+	VSMatrix GetProjection(float fov, float aspectRatio, float fovRatio) const override;
+	void GetViewShift(float yaw, float outViewShift[3]) const override;
+
+private:
+	int eye;
+};
+
+// The mode remains mono while the XR target or either eye description is
+// incomplete, preserving the M5 path until a complete M6 frame arrives.
+class WebXRDeviceMode : public Stereo3DMode
+{
+public:
+	static const Stereo3DMode& getInstance();
+
+	int eye_count() const override;
+	const EyePose *getEyePose(int ix) const override;
+	bool IsMono() const override;
+	void SetUp() const override;
+	void Present() const override;
+	void AdjustPlayerSprites(int hand = 0) const override;
+	void UnAdjustPlayerSprites() const override;
+	bool GetWeaponTransform(VSMatrix *out, int hand = 0) const override;
+	bool RenderPlayerSpritesCrossed() const override { return true; }
+	bool RenderPlayerSpritesInScene() const override { return true; }
+
+protected:
+	WebXRDeviceMode();
+
+private:
+	EyePose centralEye;
+	WebXRDeviceEyePose leftEye;
+	WebXRDeviceEyePose rightEye;
+};
+
+} // namespace s3d
+
+#endif // VR_WEBXR_H
